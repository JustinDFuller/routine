{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/routine_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tone|size|type|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, tone, size, type, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:prominent|tinted|bordered|plain)$/]",
        "message": "<Button> variant must be one of 'prominent' | 'tinted' | 'bordered' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:active|complete|destructive)$/]",
        "message": "<Button> tone must be one of 'active' | 'complete' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:settings|pencil|calendar|check|plus|minus|trash|chevron-left|chevron-updown|reorder|x)$/]",
        "message": "<Icon> name must be one of 'settings' | 'pencil' | 'calendar' | 'check' | 'plus' | 'minus' | 'trash' | 'chevron-left' | 'chevron-updown' | 'reorder' | 'x'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|tone|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, tone, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:secondary|primary|active|destructive)$/]",
        "message": "<IconButton> tone must be one of 'secondary' | 'primary' | 'active' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetadataPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|emphasized|style|key|ref|className|style|children)$/]",
        "message": "<MetadataPill> doesn't accept that prop. Declared props: children, accent, emphasized, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetadataPill'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:complete|active|muted)$/]",
        "message": "<MetadataPill> accent must be one of 'complete' | 'active' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:completed|target|fillRatio|showCheckmark|accent|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: completed, target, fillRatio, showCheckmark, accent, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:complete|active|muted)$/]",
        "message": "<ProgressRing> accent must be one of 'complete' | 'active' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoutineCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|period|lastDone|availability|completed|target|fillRatio|state|showEdit|showHistory|onComplete|onHistory|onEdit|style|key|ref|className|style|children)$/]",
        "message": "<RoutineCard> doesn't accept that prop. Declared props: name, count, period, lastDone, availability, completed, target, fillRatio, state, showEdit, showHistory, onComplete, onHistory, onEdit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoutineCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:incomplete|complete|unavailable|target-met|over-target)$/]",
        "message": "<RoutineCard> state must be one of 'incomplete' | 'complete' | 'unavailable' | 'target-met' | 'over-target'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UndoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|actionTitle|onUndo|style|key|ref|className|style|children)$/]",
        "message": "<UndoBanner> doesn't accept that prop. Declared props: message, actionTitle, onUndo, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
